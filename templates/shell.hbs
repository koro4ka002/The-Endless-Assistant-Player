<div class="ea-player-layout">
  <aside class="ea-player-sidebar">
    <nav class="ea-nav ea-player-nav">
      <button type="button" class="ea-nav__item {{#if isHome}}ea-nav__item--active is-active{{/if}}" data-action="switchTab" data-tab="home">
        <i class="fa-solid fa-house"></i>
        <span>{{localize "ENDLESS.player.nav.home"}}</span>
      </button>
      {{#each features}}
      <button type="button" class="ea-nav__item {{#if this.isActive}}ea-nav__item--active is-active{{/if}}" data-action="switchTab" data-tab="{{this.id}}">
        {{#if this.icon}}<i class="{{this.icon}}"></i>{{/if}}
        <span>{{localize this.titleKey}}</span>
      </button>
      {{/each}}
    </nav>
  </aside>
  <main class="ea-player-main">
    <div class="ea-panel ea-player-panel">
      {{#if isHome}}
      <div class="ea-plate">
        <h2>{{localize "ENDLESS.player.home.title"}}</h2>
        <p>{{localize "ENDLESS.player.home.welcome"}}</p>
      </div>
      {{#unless features.length}}
      <div class="ea-empty">
        <i class="fa-solid fa-puzzle-piece ea-empty__icon"></i>
        <div class="ea-empty__text">{{localize "ENDLESS.player.empty"}}</div>
      </div>
      {{/unless}}
      {{/if}}

      {{#if isFeature}}
      <div class="ea-player-feature-mount" data-feature-id="{{activeTab}}"></div>
      {{/if}}
    </div>
  </main>
</div>
